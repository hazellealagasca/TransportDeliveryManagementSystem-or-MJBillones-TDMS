<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- Windows-only app: tells the platform analyzer (CA1416) every API call runs on Windows 7+ -->
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <RootNamespace>Transport_Delivery_Management_System_for_M.J._Billones_Transport_Service</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Stray copies of source files (e.g. "MJdatabase-1.cs", "X - Copy.cs", "X (1).cs") made by sync, download or copy tools
       would be compiled twice and break the build with hundreds of "already contains a definition" errors (Nov 6, 2026).
       They are left out of the build and listed in a warning so they can be moved out of the project folder. -->
  <ItemGroup>
    <StrayCopy Include="**\*-1.cs;**\*-2.cs;**\*-3.cs;**\* - Copy*.cs;**\*(1).cs;**\*(2).cs;**\*(3).cs" Exclude="bin\**;obj\**" />
    <Compile Remove="@(StrayCopy)" />
    <!-- The Verify checks are their own project (folder Verify). -->
    <Compile Remove="Verify\**" />
    <None Remove="Verify\**" />
  </ItemGroup>
  <Target Name="WarnStrayCopies" BeforeTargets="BeforeBuild" Condition="'@(StrayCopy)' != ''">
    <Warning Text="Left out of the build because they are duplicate copies of source files. Move them out of the project folder: @(StrayCopy)" />
  </Target>
</Project>